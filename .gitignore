# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Env / secrets
.env
*.local

# Data / dumps
data/
*.csv
*.dump
*.sql.gz
backups/

# Terraform
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
*.duckdb
*.duckdb.wal
# dbt seeds ARE meant to be committed (they're the DuckDB target's fixture data, generated by
# scripts/generate_dbt_seeds.py from a live FRED pull) -- carve them out of the *.csv rule above.
!dbt/seeds/*.csv

# OS
.DS_Store
