# Copy to .env and fill in. .env is gitignored.

# FRED API — free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
# Which macro series to ingest (default: 10-Year Treasury Constant Maturity Rate)
FRED_SERIES_ID=DGS10

# Postgres "warehouse" connection (legacy path, retired once Snowflake is verified — see AUDIT.md)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bridge
POSTGRES_USER=bridge
POSTGRES_PASSWORD=change_me

# dbt target selection — "duckdb" (default, no cloud account needed) or "snowflake"
DBT_TARGET=duckdb
DBT_DUCKDB_PATH=bridge.duckdb
# api/ (Phase 9) reads the same DBT_DUCKDB_PATH file, read-only -- no separate API config

# Snowflake — only needed when DBT_TARGET=snowflake. Values come from the trial account setup
# in infra/snowflake_setup.sql (see DECISIONS.md for the objects it creates).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=BRIDGE_DBT_ROLE
SNOWFLAKE_WAREHOUSE=BRIDGE_WH
SNOWFLAKE_DATABASE=BRIDGE_DB
SNOWFLAKE_SCHEMA=STAGING
