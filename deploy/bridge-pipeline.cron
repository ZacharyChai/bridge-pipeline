# Bridge pipeline — daily FRED pull. Installed to /etc/cron.d/bridge-pipeline.
# cron.d format includes the user field (deploy). deploy is in the docker group.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# 06:30 UTC daily — after FRED's overnight update on business days.
30 6 * * * deploy cd /opt/bridge && docker compose -f docker-compose.prod.yml --profile batch run --rm pipeline >> /opt/bridge/pipeline.log 2>&1
