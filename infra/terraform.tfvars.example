# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

project_id = "your-gcp-project-id"

# Lock SSH to your own IP. Find it with: curl ifconfig.me
ssh_source_ranges = ["203.0.113.4/32"]

# Optional overrides (defaults shown):
# region          = "us-central1"
# zone            = "us-central1-a"
# machine_type    = "e2-small"              # "e2-micro" is Always-Free eligible
# image           = "debian-cloud/debian-12"
# disk_size_gb    = 20
# ssh_user        = "deploy"
# ssh_pubkey_path = "~/.ssh/id_ed25519.pub"
